# Copy to .env.worker and fill in. This file holds secrets: never commit or share it.

# Supabase > project sophishan-clipper > Connect > Session pooler (port 5432).
# Replace [YOUR-PASSWORD] with the database password.
DATABASE_URL=

# Supabase project URL.
SUPABASE_URL=https://hmegcnrpmyxqwqpeploj.supabase.co
# Supabase > Project Settings > API Keys: the service_role key (starts with eyJ).
SUPABASE_SERVICE_ROLE_KEY=

# 9Router: the same base URL, key and model you use today. If 9Router runs on
# this machine, http://host.docker.internal:<port> reaches it from the container.
CLIPPER_LLM_BASE_URL=
CLIPPER_LLM_API_KEY=
CLIPPER_LLM_MODEL=cx/gpt-6-astra

# A name for this worker in the jobs table.
CLIPPER_WORKER_ID=laptop-1

# Optional: only if YouTube starts refusing downloads.
YTDLP_COOKIES_FILE=
YTDLP_PROXY=

# Optional: "Kabari saya saat klip siap" emails. Resend > API Keys (starts with
# re_), on the sofish.tech domain already verified for login emails. Without it
# no done emails are sent.
RESEND_API_KEY=
NOTIFY_FROM=Sofish <notif@sofish.tech>
