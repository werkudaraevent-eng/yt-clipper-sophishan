# Copy to .env (never commit the real file).

# Supabase (Project settings > API)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Set to 1 after enabling the Google provider in Supabase Auth.
NEXT_PUBLIC_GOOGLE_AUTH=
# Cloudflare Turnstile site key for the email sign-in form (the secret goes in
# Supabase Auth > Attack Protection). Set this before turning CAPTCHA on there.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Shown on /privacy and /terms as the support address.
NEXT_PUBLIC_CONTACT_EMAIL=
# Posting clips to YouTube: an OAuth web client (redirect URI
# <site>/api/youtube/callback) and 32 random bytes for encrypting refresh
# tokens (`openssl rand -base64 32`). The feature stays hidden until all three are set.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
SOCIAL_TOKEN_KEY=
# Scheduled posts: Vercel Cron calls /api/cron/scheduled-posts every minute with
# this secret (`openssl rand -hex 32`). Its SHA-256 is stored in private.settings
# (key scheduler_token_sha256) so the database accepts the cron. Scheduling stays
# hidden until it is set. YOUTUBE_API_KEY (YouTube Data API v3, public data only)
# reads first-day views of posted Shorts so time suggestions learn the channel.
CRON_SECRET=
YOUTUBE_API_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Buying credits through DOKU Checkout (Back Office > API keys). DOKU_ENV is
# "sandbox" or "production". PAYMENTS_DB_TOKEN is a random secret whose SHA-256
# is stored in private.settings (key payments_token_sha256); the database only
# adds purchased credits when it gets this token. Buying stays off until all are set.
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
DOKU_ENV=sandbox
PAYMENTS_DB_TOKEN=

# Worker: direct Postgres connection used to claim jobs
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Supabase for the worker (uploads rendered clips to the `clips` bucket).
# Leave empty in local dev to keep clips on disk.
SUPABASE_URL=

# LLM for highlight detection, hook titles and translation.
# Direct Anthropic API: set ANTHROPIC_API_KEY only.
ANTHROPIC_API_KEY=
# Or a gateway speaking the Anthropic Messages API (e.g. 9Router):
# its base URL, its key (sent as Bearer), and a model name the gateway knows
# in CLIPPER_LLM_MODEL. Leave ANTHROPIC_API_KEY empty in that case.
CLIPPER_LLM_BASE_URL=
CLIPPER_LLM_API_KEY=
CLIPPER_LLM_MODEL=claude-opus-5

# Optional: YouTube download hardening
YTDLP_COOKIES_FILE=
YTDLP_PROXY=
