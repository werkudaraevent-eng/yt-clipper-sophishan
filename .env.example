# Copy to .env (never commit the real file).

# Supabase (Project settings > API)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Worker: direct Postgres connection used to claim jobs
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# LLM for highlight detection, hook titles and translation
ANTHROPIC_API_KEY=
CLIPPER_LLM_MODEL=claude-sonnet-5

# Optional: YouTube download hardening
YTDLP_COOKIES_FILE=
YTDLP_PROXY=
