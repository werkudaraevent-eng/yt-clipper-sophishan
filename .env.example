# Copy to .env (never commit the real file).

# Supabase (Project settings > API)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Worker: direct Postgres connection used to claim jobs
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Supabase for the worker (uploads rendered clips to the `clips` bucket).
# Leave empty in local dev to keep clips on disk.
SUPABASE_URL=

# LLM for highlight detection, hook titles and translation.
# Direct Anthropic API: set ANTHROPIC_API_KEY only.
ANTHROPIC_API_KEY=
# Or a gateway speaking the Anthropic Messages API (e.g. 9Router):
# base URL without /v1, its key as ANTHROPIC_AUTH_TOKEN, and a model name the
# gateway knows in CLIPPER_LLM_MODEL.
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
CLIPPER_LLM_MODEL=claude-opus-5

# Optional: YouTube download hardening
YTDLP_COOKIES_FILE=
YTDLP_PROXY=
